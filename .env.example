# 端口号（容器内监听端口，须与 NEW_API_PORT_MAPPING 的容器侧一致）
# PORT=3000
# 前端基础URL（非空时服务端不再托管前端，页面请求会 301 到该地址）
# FRONTEND_BASE_URL=https://your-frontend-url.com
# 主从节点角色，多实例部署时从节点设为 slave
# NODE_TYPE=master
# 反向代理信任，决定是否采信 X-Forwarded-For / X-Real-IP：
#   auto（默认）  由进程从自身网卡推导所在网段。容器部署（Docker、K8s、Podman）用这个，
#                 不需要知道宿主机网桥网段，网络重建后也无需改配置。
#   <留空>        不信任任何转发头。请求按 socket 地址识别，反代后所有客户端会塌缩到
#                 同一个限流桶。仅在确实没有反向代理时使用。
#   <IP/CIDR 列表> 逗号分隔，显式指定可信代理。适合代理不在本机网段，或需要严格收窄的场景。
#
# 安全边界：auto 信任的是"与本进程同一网段"的来源。若容器端口直接发布到宿主机
# （例如 ports: 0.0.0.0:13000:3000），经该端口进入的请求其 socket 地址是 Docker 网关，
# 同样落在容器网段内，因此它自带的 X-Forwarded-For 也会被采信，可被用来伪造来源 IP。
# 要么不要直接发布应用端口，要么在该端口前置一层会重写转发头的代理。
# TRUSTED_PROXIES=auto

# Docker 镜像与宿主机绑定目录
# 镜像标签，可按本地构建结果或远端仓库镜像调整
# NEW_API_IMAGE=new-api-local:prod-main
# Optional container names. Override these when running multiple Compose instances.
# NEW_API_CONTAINER_NAME=new-api
# REDIS_CONTAINER_NAME=redis
# POSTGRES_CONTAINER_NAME=postgres
#
# Docker 端口发布映射，默认由 docker-compose.yml 发布为 3000:3000（局域网可访问）
# 直接暴露服务时可保持未设置，或显式写成:
# NEW_API_PORT_MAPPING=3000:3000
#
# 如果宿主机 3000 由 Caddy/Nginx 等本机代理占用，可改为只发布到本机回环端口
# 示例: macOS Docker Desktop + 宿主机 Caddy 入口 3000 -> Docker loopback 13000
# NEW_API_PORT_MAPPING=127.0.0.1:13000:3000
#
# 数据目录与日志目录建议显式设置，避免依赖 Compose 对相对路径的隐式解析
# macOS:
# NEW_API_DATA_DIR=/path/to/new-api/data
# NEW_API_LOG_DIR=/path/to/new-api/logs
#
# Linux:
# NEW_API_DATA_DIR=/srv/new-api/data
# NEW_API_LOG_DIR=/srv/new-api/logs
#
# Windows（请使用 Docker Compose 可识别的绝对路径格式）:
# NEW_API_DATA_DIR=C:/new-api/data
# NEW_API_LOG_DIR=C:/new-api/logs
#
# WSL:
# NEW_API_DATA_DIR=/home/<user>/new-api/data
# NEW_API_LOG_DIR=/home/<user>/new-api/logs
#
# 如果不显式设置，则默认使用项目目录下的 ./data 和 ./logs
# NEW_API_DATA_DIR=./data
# NEW_API_LOG_DIR=./logs
#
# 根目录 Docker Compose 的数据库和 Redis 配置为必填项。以下仅是格式示例，
# 不要把占位值用于正式环境，并确保 DSN 中的密码与对应密码变量一致。
# SQL_DSN=postgresql://root:<postgres-password>@postgres:5432/new-api
# POSTGRES_PASSWORD=<postgres-password>
# REDIS_CONN_STRING=redis://:<redis-password>@redis:6379/0
# REDIS_PASSWORD=<redis-password>
#
# 开发环境编排已拆分为两类:
# 1. 完全隔离开发环境: deploy/compose/dev-isolated.yml
# 2. 只读前端联调环境: deploy/compose/frontend-readonly-proxy.yml
# 兼容入口 docker-compose.dev.yml 仅用于本地源码构建，使用 DEV_* 参数。
# DEV_LEGACY_COMPOSE_PROJECT_NAME=new-api-dev
# DEV_LEGACY_NEW_API_PORT=3002
# DEV_LEGACY_POSTGRES_PORT=5434
# DEV_LEGACY_REDIS_PORT=6381
# 对应模板见:
# - deploy/env/dev-legacy.env.example
# - deploy/env/dev-isolated.env.example
# - deploy/env/frontend-readonly.env.example


# 调试相关配置
# 启用pprof
# ENABLE_PPROF=true
# 启用调试模式
# DEBUG=true
# Pyroscope 配置
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=new-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# 数据库相关配置
# 启用错误日志记录
# ERROR_LOG_ENABLED=true
# 数据库连接字符串
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# 日志数据库连接字符串
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# SQLite数据库路径
# SQLITE_PATH=/path/to/sqlite.db
# 数据库最大空闲连接数
# SQL_MAX_IDLE_CONNS=100
# 数据库最大打开连接数
# SQL_MAX_OPEN_CONNS=1000
# 数据库连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60


# 缓存相关配置
# Redis连接字符串
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# Redis 密码（根目录 Docker Compose 必填，并应与 REDIS_CONN_STRING 中的密码一致）
# REDIS_PASSWORD=<redis-password>
# 节点名称（可选，建议多实例或容器部署时设置，便于充值审计日志定位具体节点）
# NODE_NAME=new-api-node-1

# 通用渠道路由与容量治理（迁移完成后由正式环境显式开启）
# CHANNEL_ROUTING_V2_ENABLED=false
# CHANNEL_ROUTING_SHADOW_ENABLED=false
# CHANNEL_ROUTING_V2_STRICT_WRITES=false
# CHANNEL_CONCURRENCY_STRICT=true
# CHANNEL_CONCURRENCY_LEASE_TTL_SECONDS=30
# CHANNEL_CONCURRENCY_RESELECT_LIMIT=5
# 桌面端 OAuth handoff:
# - 单实例本地开发可不启用 Redis，系统会退回进程内内存状态
# - Docker 多实例、Kubernetes、多副本负载均衡部署必须启用 Redis
# - 否则 /api/oauth/desktop/start、OAuth callback、/api/oauth/desktop/poll 落到不同实例时会丢失 handoff 状态
# 桌面端 OAuth 轮询限流，按 handoff_token 分桶，默认允许 3 分钟内 180 次
# DESKTOP_OAUTH_POLL_RATE_LIMIT_ENABLE=true
# DESKTOP_OAUTH_POLL_RATE_LIMIT=180
# DESKTOP_OAUTH_POLL_RATE_LIMIT_DURATION=180
# 全局限流（仅环境变量生效，后台设置页没有对应选项）
# 各限流器的总开关，设为 false 即整条限流不挂载。默认均为 true。
# GLOBAL_API_RATE_LIMIT_ENABLE=true
# GLOBAL_WEB_RATE_LIMIT_ENABLE=true
# CRITICAL_RATE_LIMIT_ENABLE=true
# SEARCH_RATE_LIMIT_ENABLE=true
# SUGGESTION_RATE_LIMIT_ENABLE=true
# 全局 API 限流，按客户端 IP 分桶，默认 3 分钟内 180 次
# GLOBAL_API_RATE_LIMIT=180
# GLOBAL_API_RATE_LIMIT_DURATION=180
# 全局页面限流，按客户端 IP 分桶，默认 3 分钟内 60 次
# GLOBAL_WEB_RATE_LIMIT=60
# GLOBAL_WEB_RATE_LIMIT_DURATION=180
# 关键接口限流（登录、注册、找回密码、支付等），默认 20 分钟内 20 次
# CRITICAL_RATE_LIMIT=20
# CRITICAL_RATE_LIMIT_DURATION=1200
# 搜索限流，按用户 ID 分桶，默认 1 分钟内 10 次
# SEARCH_RATE_LIMIT=10
# SEARCH_RATE_LIMIT_DURATION=60
# 联想（自动补全）限流，按用户 ID 分桶，默认 1 分钟内 60 次
# SUGGESTION_RATE_LIMIT=60
# SUGGESTION_RATE_LIMIT_DURATION=60
# 管理员豁免全局限流。仅在首次启动、选项尚不存在时用于播种
# GlobalRateLimitAdminExemptEnabled；此后以后台「速率限制设置」中的开关为准。
# 开启后管理员不再受全局 API 限流、全局页面限流、搜索限流和联想限流限制，
# 关键接口限流（CRITICAL_RATE_LIMIT）始终对管理员生效。
# GLOBAL_RATE_LIMIT_ADMIN_EXEMPT=false
# 同步频率（单位：秒）
# SYNC_FREQUENCY=60
# 内存缓存启用
# MEMORY_CACHE_ENABLED=true
# 组模型路由辅助匹配，默认启用；显式设为 false 时仅按精确模型名匹配
# GROUP_MODEL_ROUTE_HELPER_ENABLED=true
# 渠道更新频率（单位：分钟）
# CHANNEL_UPDATE_FREQUENCY=30
# 批量更新启用
# BATCH_UPDATE_ENABLED=true
# 批量更新间隔（单位：秒）
# BATCH_UPDATE_INTERVAL=5

# 任务和功能配置
# 更新任务启用
# UPDATE_TASK=true

# 对话超时设置
# 所有请求超时时间，单位秒，默认为0，表示不限制
# RELAY_TIMEOUT=0
# 流模式无响应超时时间，单位秒，如果出现空补全可以尝试改为更大值
# STREAMING_TIMEOUT=300

# TLS / HTTP 跳过验证设置
# TLS_INSECURE_SKIP_VERIFY=false

# Gemini 识别图片 最大图片数量
# GEMINI_VISION_MAX_IMAGE_NUM=16

# 会话密钥
# SESSION_SECRET=random_string

# 其他配置
# 生成默认token
# GENERATE_DEFAULT_TOKEN=false
# Cohere 安全设置
# COHERE_SAFETY_SETTING=NONE
# 是否统计图片token
# GET_MEDIA_TOKEN=true
# 是否在非流（stream=false）情况下统计图片token
# GET_MEDIA_TOKEN_NOT_STREAM=false
# 设置 Dify 渠道是否输出工作流和节点信息到客户端
# DIFY_DEBUG=true

# LinuxDo相关配置
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# 节点类型
# 如果是主节点则为master
# NODE_TYPE=master

# 可信任重定向域名列表（逗号分隔，支持子域名匹配）
# 用于验证支付成功/取消回调URL的域名安全性
# 示例: example.com,myapp.io 将允许 example.com, sub.example.com, myapp.io 等
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io
