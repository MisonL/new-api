{
  "name": "react-template",
  "packageManager": "bun@1.4.3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@douyinfe/semi-icons": "^2.104.0",
    "@douyinfe/semi-ui": "^2.104.0",
    "@lobehub/fluent-emoji": "^5.0.0",
    "@lobehub/icons": "^6.7.0",
    "@lobehub/ui": "^6.7.0",
    "@shikijs/themes": "^4.5.0",
    "@visactor/react-vchart": "^2.2.0",
    "@visactor/vchart": "^2.2.0",
    "@visactor/vchart-semi-theme": "^1.13.1",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "history": "^5.3.0",
    "i18next": "^26.5.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-i18next": "^17.1.3",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-telegram-login": "^1.1.2",
    "react-toastify": "^11.1.0",
    "react-turnstile": "^1.1.5",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "sse.js": "^2.8.0",
    "unist-util-visit": "^5.1.0",
    "use-debounce": "^10.1.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/run-with-node-options.mjs --optional-node-option=--no-experimental-webstorage -- vite build && node ../scripts/safari-compatibility.mjs dist && node ../scripts/check-browser-compatibility.mjs dist",
    "build:fast": "node ../scripts/run-with-node-options.mjs --optional-node-option=--no-experimental-webstorage --env=VITE_FAST_BUILD=true -- vite build",
    "build:profile": "node ../scripts/run-with-node-options.mjs --optional-node-option=--no-experimental-webstorage --env=DEBUG=vite:time -- vite build",
    "test:browser-compat": "node ../scripts/browser-cross-verify.mjs --url http://localhost:3000/console",
    "test:desktop-runtime": "node --test ../tests/desktopRuntime.test.mjs",
    "test:setup-validation": "node --test ../tests/setupValidation.test.mjs",
    "test:node": "node --test ../tests/*.test.mjs",
    "lint": "prettier . --check",
    "lint:fix": "prettier . --write",
    "eslint": "bun x eslint \"**/*.{js,jsx}\" --cache",
    "eslint:fix": "bun x eslint \"**/*.{js,jsx}\" --fix --cache",
    "preview": "vite preview",
    "i18n:extract": "bun x i18next-cli extract",
    "i18n:status": "bun x i18next-cli status",
    "i18n:sync": "bun x i18next-cli sync",
    "i18n:lint:raw": "bun x i18next-cli lint",
    "i18n:lint": "node ../scripts/i18nLintGate.mjs",
    "i18n:lint:update-baseline": "node ../scripts/i18nLintGate.mjs --write-baseline"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@douyinfe/vite-plugin-semi": "^2.74.0-alpha.6",
    "@so1ve/prettier-config": "^4.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "code-inspector-plugin": "^2.0.9",
    "esbuild": "^0.28.0",
    "eslint": "^10.13.0",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "i18next-cli": "^1.80.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.10.19",
    "browserslist": "4.28.8",
    "caniuse-lite": "^1.0.30001788",
    "decode-uri-component": "0.5.0",
    "electron-to-chromium": "^1.5.336",
    "follow-redirects": "1.16.1",
    "glob": "11.1.0",
    "lodash": "4.18.0",
    "lodash-es": "4.18.0",
    "minimatch": "10.2.3",
    "minimist": "1.2.6",
    "node-releases": "^2.0.37",
    "postcss-selector-parser": "^7.1.6",
    "update-browserslist-db": "^1.2.3",
    "katex": "^0.18.11",
    "dompurify": "^3.4.17"
  },
  "prettier": {
    "singleQuote": true,
    "jsxSingleQuote": true
  },
  "proxy": "http://localhost:3000"
}
