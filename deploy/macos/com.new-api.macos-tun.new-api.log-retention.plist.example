<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LOG_RETENTION_LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__LOG_RETENTION_RUNNER__</string>
    <string>--lock</string>
    <string>__LOG_RETENTION_LOCK__</string>
    <string>--log</string>
    <string>__LOG_RETENTION_LOG__</string>
    <string>--keep</string>
    <string>__LOG_RETENTION_LOG_KEEP__</string>
    <string>--timeout</string>
    <string>__LOG_RETENTION_TIMEOUT__</string>
    <string>--</string>
    <string>__LOG_RETENTION_SCRIPT__</string>
    <string>--apply</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NEW_API_LOG_RETENTION_DIR</key>
    <string>__LOG_RETENTION_DIR__</string>
    <key>NEW_API_LOG_RETENTION_STATE_FILE</key>
    <string>__LOG_RETENTION_STATE__</string>
    <key>NEW_API_LOG_RETENTION_DAYS</key>
    <string>__LOG_RETENTION_DAYS__</string>
    <key>NEW_API_LOG_RETENTION_KEEP_FILES</key>
    <string>__LOG_RETENTION_KEEP_FILES__</string>
    <key>NEW_API_LOG_RETENTION_MIN_INTERVAL_SECONDS</key>
    <string>__LOG_RETENTION_MIN_INTERVAL__</string>
    <key>NEW_API_LOG_RETENTION_OPEN_PATH_CHECKER</key>
    <string>__LOG_RETENTION_OPEN_PATH_CHECKER__</string>
    <key>NEW_API_LOG_RETENTION_VOLUME_PATH</key>
    <string>__LOG_RETENTION_VOLUME_PATH__</string>
    <key>NEW_API_LOG_RETENTION_VOLUME_UUID</key>
    <string>__LOG_RETENTION_VOLUME_UUID__</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>ThrottleInterval</key>
  <integer>300</integer>
  <key>ExitTimeOut</key>
  <integer>960</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>__LOG_RETENTION_LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG_RETENTION_LOG__</string>
</dict>
</plist>
