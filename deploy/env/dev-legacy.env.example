# 复制为 deploy/env/dev-legacy.env 后再启动
#
# 设计目标:
# - 兼容 docker-compose.dev.yml 的本地源码构建入口
# - 使用命名卷和独立项目名，不复用正式服务

DEV_LEGACY_COMPOSE_PROJECT_NAME=new-api-dev
DEV_LEGACY_NEW_API_PORT=3002
DEV_LEGACY_POSTGRES_PORT=5434
DEV_LEGACY_REDIS_PORT=6381

DEV_NEW_API_IMAGE=new-api-dev:local

# 必填: 不得复用正式环境 secret
DEV_SESSION_SECRET=
DEV_CRYPTO_SECRET=

DEV_POSTGRES_USER=root
DEV_POSTGRES_PASSWORD=
DEV_POSTGRES_DB=new-api-dev
# 与 DEV_POSTGRES_PASSWORD 中的密码保持一致
DEV_SQL_DSN=

DEV_REDIS_PASSWORD=
# 与 DEV_REDIS_PASSWORD 中的密码保持一致
DEV_REDIS_CONN_STRING=

DEV_NODE_NAME=dev-legacy-node
DEV_TZ=Asia/Shanghai
DEV_ERROR_LOG_ENABLED=true
DEV_BATCH_UPDATE_ENABLED=true
