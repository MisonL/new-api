# Copy to deploy/env/storage-postgres.env before using the storage overlay.
#
# This file is for PostgreSQL PGDATA bind-mount storage only. Do not expose
# these host paths through the Web UI.

# Required: absolute path to the PostgreSQL data directory on the fast storage.
# Create this directory explicitly before using the overlay. It must be empty
# for a new restore target, or contain the intended migrated PostgreSQL cluster.
# Use scripts/storage-migrate-postgres.sh to populate it from an existing
# new-api PostgreSQL container.
#
# macOS example:
# mkdir -p /Volumes/FastSSD/new-api/postgres/data
# NEW_API_POSTGRES_DATA_DIR=/Volumes/FastSSD/new-api/postgres/data
#
# Linux example:
# mkdir -p /srv/new-api/postgres/data
# NEW_API_POSTGRES_DATA_DIR=/srv/new-api/postgres/data
#
# Windows Docker Desktop example:
# NEW_API_POSTGRES_DATA_DIR=C:/new-api/postgres/data
#
# WSL2 example, prefer the Linux ext4 filesystem inside the distro:
# NEW_API_POSTGRES_DATA_DIR=/home/<user>/new-api/postgres/data
NEW_API_POSTGRES_DATA_DIR=

# Required: absolute path to a marker file outside PGDATA.
# The file content must exactly match NEW_API_POSTGRES_MARKER_VALUE.
# Keep this marker outside PGDATA. The marker is checked before PostgreSQL
# starts; placing it inside PGDATA creates a circular dependency and makes it
# harder to detect a missing host mount.
#
# Example:
#   mkdir -p /Volumes/FastSSD/new-api/postgres
#   printf '%s' 'new-api-prod-postgres-fast-storage-20260612' \
#     > /Volumes/FastSSD/new-api/postgres/storage.marker
#   test "$(cat /Volumes/FastSSD/new-api/postgres/storage.marker)" \
#     = 'new-api-prod-postgres-fast-storage-20260612'
NEW_API_POSTGRES_MARKER=
NEW_API_POSTGRES_MARKER_VALUE=

# Optional: explicit PostgreSQL tuning arguments for the storage overlay.
# Default: empty, which keeps the PostgreSQL image defaults.
#
# Format: space-separated key=value entries for values without spaces.
# Use | as the separator when a value itself contains spaces.
# The compose overlay accepts only this documented allowlist:
# shared_buffers, effective_cache_size, maintenance_work_mem, work_mem,
# checkpoint_timeout, max_wal_size, min_wal_size,
# checkpoint_completion_target, wal_compression,
# effective_io_concurrency, random_page_cost,
# log_min_duration_statement.
#
# Conservative write-heavy starting point for a small Docker deployment:
# NEW_API_POSTGRES_TUNING_ARGS=checkpoint_timeout=15min|max_wal_size=4GB|min_wal_size=512MB|wal_compression=on|effective_io_concurrency=32|random_page_cost=1.5|log_min_duration_statement=500ms
NEW_API_POSTGRES_TUNING_ARGS=

# Optional migration-script override only.
# Risk level: high. Use only after manually confirming that
# NEW_API_POSTGRES_DATA_DIR points to the intended existing target cluster or
# trusted rollback directory. The script will drop and recreate POSTGRES_DB
# inside that target cluster before pg_restore. There is no automatic rollback
# to the original PGDATA after PostgreSQL replacement starts; keep a separate
# backup and the old storage path available before enabling this override.
# ALLOW_NON_EMPTY_TARGET=true

# Required only for scripts/storage-migrate-postgres.sh --execute.
# First run --dry-run and copy the exact execute_confirmation_required value.
# Example:
# CONFIRM_STORAGE_MIGRATION=execute:postgres:new-api:new-api:/PATH/TO/YOUR/FAST/STORAGE/postgres/data

# Optional migration-script safety knobs.
# BACKUP_MIN_FREE_PERCENT requires BACKUP_DIR free space to be at least this
# percentage of current PGDATA before --execute stops services. Default: 30.
# BACKUP_MIN_FREE_PERCENT=30
#
# GLOBALS_FILE is only needed when restoring from an existing DUMP_FILE and you
# want to keep the matching pg_dumpall --globals-only file visible for manual
# role or privilege recovery review.
# GLOBALS_FILE=

# Planning-only variables for scripts/storage-plan-linux.sh and
# scripts/storage-plan-windows.ps1. The standard compose overlay does not use
# these variables. They exist so operators can evaluate the full hot-path plan
# without implying that advanced storage changes are automatic.
#
# Advanced only:
# NEW_API_POSTGRES_WAL_DIR=
#
# Existing base docker-compose.yml variables:
# NEW_API_DATA_DIR=
# NEW_API_LOG_DIR=
#
# Expert host-level planning only:
# NEW_API_DOCKER_DATA_DIR=
