# 复制为 deploy/env/dev-isolated.env 后再启动
#
# 设计目标:
# - 与正式 new-api、正式 PostgreSQL、正式 Redis 完全隔离
# - 独立端口、独立数据库目录、独立应用数据目录、独立日志目录

DEV_NEW_API_IMAGE=new-api-local:dev
DEV_COMPOSE_PROJECT_NAME=new-api-dev-isolated
DEV_NEW_API_PORT=3001
DEV_POSTGRES_PORT=5433
DEV_REDIS_PORT=6380

# 必填: 宿主机绝对路径。以下三个变量为空时 Compose 会拒绝启动，
# 请复制对应平台的示例路径并确认目录不属于正式环境。
# macOS:
# DEV_NEW_API_DATA_DIR=/Volumes/Work/code/new-api/.dev-docker/runtime/isolated/data
# DEV_NEW_API_LOG_DIR=/Volumes/Work/code/new-api/.dev-docker/runtime/isolated/logs
# DEV_POSTGRES_DATA_DIR=/Volumes/Work/code/new-api/.dev-docker/runtime/isolated/postgres
#
# Linux:
# DEV_NEW_API_DATA_DIR=/srv/new-api/dev/data
# DEV_NEW_API_LOG_DIR=/srv/new-api/dev/logs
# DEV_POSTGRES_DATA_DIR=/srv/new-api/dev/postgres
#
# Windows:
# DEV_NEW_API_DATA_DIR=C:/new-api/dev/data
# DEV_NEW_API_LOG_DIR=C:/new-api/dev/logs
# DEV_POSTGRES_DATA_DIR=C:/new-api/dev/postgres
#
# WSL:
# DEV_NEW_API_DATA_DIR=/home/<user>/new-api/.dev-docker/runtime/isolated/data
# DEV_NEW_API_LOG_DIR=/home/<user>/new-api/.dev-docker/runtime/isolated/logs
# DEV_POSTGRES_DATA_DIR=/home/<user>/new-api/.dev-docker/runtime/isolated/postgres
DEV_NEW_API_DATA_DIR=
DEV_NEW_API_LOG_DIR=
DEV_POSTGRES_DATA_DIR=

# 必填: 不得复用正式环境 secret。所有空值都必须在启动前填写。
DEV_SESSION_SECRET=
DEV_CRYPTO_SECRET=

DEV_POSTGRES_USER=root
# 与 DEV_SQL_DSN 中的密码保持一致
DEV_POSTGRES_PASSWORD=
DEV_POSTGRES_DB=new-api-dev
DEV_SQL_DSN=
# 与 DEV_REDIS_CONN_STRING 中的密码保持一致
DEV_REDIS_PASSWORD=
DEV_REDIS_CONN_STRING=
DEV_NODE_NAME=dev-isolated-node-1
DEV_TZ=Asia/Shanghai
DEV_ERROR_LOG_ENABLED=true
DEV_BATCH_UPDATE_ENABLED=true
# 全局限流阈值（仅环境变量生效，后台设置页无对应选项）。留空即使用与正式环境一致的默认值。
# DEV_GLOBAL_API_RATE_LIMIT=180
# DEV_GLOBAL_API_RATE_LIMIT_DURATION=180
# DEV_GLOBAL_WEB_RATE_LIMIT=60
# DEV_GLOBAL_WEB_RATE_LIMIT_DURATION=180
# 管理员豁免全局限流。仅在选项 GlobalRateLimitAdminExemptEnabled 尚不存在时播种，
# 此后以后台「速率限制设置」中的开关为准。
DEV_GLOBAL_RATE_LIMIT_ADMIN_EXEMPT=false
DEV_CHANNEL_UPSTREAM_MODEL_UPDATE_TASK_ENABLED=false
DEV_CHANNEL_CACHE_SYNC_ENABLED=false
# The isolated stack runs the route-scope selector by default. Set these
# explicitly when comparing legacy/shadow behavior.
DEV_CHANNEL_ROUTING_V2_ENABLED=true
DEV_CHANNEL_ROUTING_SHADOW_ENABLED=false
DEV_CHANNEL_ROUTING_V2_STRICT_WRITES=true
DEV_CHANNEL_CONCURRENCY_STRICT=true
DEV_UPDATE_TASK=false
DEV_SUBSCRIPTION_QUOTA_RESET_TASK_ENABLED=false
